{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "IAM": {
    "BaseUrl": null,
    "LoginPath": "api/auth/login",
    "TimeoutSeconds": 15
  },
  "FileStorage": {
    "BasePath": ""
  },
  "Notification": {
    "SmsApiUrl": "",
    "EmailApiUrl": ""
  },
  "Sla": {
    "WarningWindowHours": 48
  },
  "OfficeScopes": {
    "Map": {
      "Head Office": "HeadOffice",
      "Regional Office": "Region",
      "Branch": "Branch"
    }
  },
  "Auth": {
    "Issuer": "hgb-cmp-api",
    "Audience": "hgb-cmp-portal",
    "TokenLifetimeMinutes": 480
  },
  "MockIam": {
    "Enabled": false
  },
  "Attachments": {
    "MaxFileBytes": 5242880,
    "MaxFilesPerUpload": 5,
    "MaxFilesPerComplaint": 20
  },
  "Escalation": {
    "JobEnabled": true,
    "IntervalMinutes": 15
  },
  "Notifications": {
    "Provider": "None",
    "IntervalSeconds": 30
  },
  "Tracking": {
    "OtpLifetimeMinutes": 10,
    "MaxOtpAttempts": 5,
    "MaxOtpsPerWindow": 3,
    "OtpWindowMinutes": 15,
    "ExposeOtpForTesting": false
  },
  "RateLimits": {
    "PublicPerMinute": 10,
    "PublicReadPerMinute": 60,
    "LoginPerMinute": 10
  }
}
