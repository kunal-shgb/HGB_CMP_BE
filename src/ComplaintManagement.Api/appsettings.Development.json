{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MockIam": {
    "Enabled": true
  },
  "FileStorage": {
    "BasePath": "../../.data/attachments"
  },
  "Notifications": {
    "Provider": "Log",
    "IntervalSeconds": 10
  },
  "Tracking": {
    "ExposeOtpForTesting": true
  }
}
