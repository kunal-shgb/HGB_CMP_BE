  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComplaintManagement.Application\ComplaintManagement.Application.csproj" />
    <ProjectReference Include="..\ComplaintManagement.Infrastructure\ComplaintManagement.Infrastructure.csproj" />
